# ReconcileX — environment variables
#
# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
#
# .env.local is gitignored — never commit real keys.
# Everything below is optional in the sense that the app still runs without
# it (it falls back to simulated data / simulated AI), but you need the
# Razorpay keys to exercise the real Razorpay Test Mode flow, and HF_TOKEN
# to get real AI-generated investigations instead of the deterministic-only
# fallback.

# --- Razorpay (Test Mode) ---------------------------------------------------
# Get these from the Razorpay Dashboard → Settings → API Keys.
# IMPORTANT: only ever use TEST keys here (they start with rzp_test_ / a
# matching test secret). Never paste live/production keys into this app.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Used to verify incoming webhooks (Dashboard → Webhooks → your endpoint →
# Secret). Required only if you want /api/webhooks/razorpay to accept live
# events instead of relying on the manual "confirm payment" / "check refund
# status" flows.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- AI investigation layer -------------------------------------------------
# Free-tier token from https://huggingface.co/settings/tokens (no billing
# required). Without this, the AI Investigation step returns "UNAVAILABLE"
# and the app falls back to deterministic evidence only — the rest of the
# app still works.
HF_TOKEN=your_huggingface_token_here

# Optional — override the default model (meta-llama/Llama-3.3-70B-Instruct)
# served via Hugging Face's Inference Providers router.
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Demo / local dev --------------------------------------------------------
# Set to "true" to allow POST /api/reset to wipe and reseed demo data when
# NODE_ENV=production (e.g. on a deployed demo instance for judges to reset
# between walkthroughs). Not needed for local development.
# ALLOW_DEMO_RESET=true

