# Required for the AI investigation layer (lib/ai/investigator.ts).
# Get a free token at https://huggingface.co/settings/tokens (no billing needed).
# Without this set, ReconcileX still works end-to-end: cases are still detected,
# scored, and resolved by the deterministic engine — the "Investigate" button
# will simply report the AI layer as unavailable and fall back to the
# deterministic evidence, exactly as it does on any API failure.
HF_TOKEN=

# Optional — override the default free-tier model routed through Hugging Face's
# Inference Providers (router.huggingface.co). Defaults to meta-llama/Llama-3.3-70B-Instruct.
HF_MODEL=

# --- Razorpay TEST MODE only. Never put live (rzp_live_...) keys here. ---
# Get these from the Razorpay Dashboard → Settings → API Keys, with
# "Test Mode" toggled ON (top-right switch in the dashboard).
# Without these set, the app still runs fully in Simulation Mode — the
# Razorpay Test Demo page will show "Not configured" and disable itself.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Razorpay Dashboard → Settings → Webhooks → (create one) → Secret.
# Required for POST /api/webhooks/razorpay to accept anything — without it,
# the webhook route always rejects requests rather than silently trusting
# an unverifiable payload. NOTE: Razorpay cannot reach http://localhost —
# you need a public tunnel (e.g. `ngrok http 3000`, or VS Code's port
# forwarding set to Public) and to register that tunnel's https URL as the
# webhook endpoint for this to ever actually fire locally. See README
# "Razorpay Test Mode Integration" section.
RAZORPAY_WEBHOOK_SECRET=

# Set to "true" to allow POST /api/reset (and the Reset Demo Data button) in a
# production build. Not needed in development.
ALLOW_DEMO_RESET=false